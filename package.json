{
  "name": "leafling",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Leafling — personal Hebrew-first plant care PWA (Cloudflare Workers + D1 + R2).",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run test:e2e",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "verify:live": "NODE_USE_ENV_PROXY=1 node scripts/verify-live.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@fontsource-variable/rubik": "5.3.0",
    "dexie": "4.4.6",
    "dexie-react-hooks": "4.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261002.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.5",
    "miniflare": "4.20260730.0",
    "playwright-core": "1.56.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
